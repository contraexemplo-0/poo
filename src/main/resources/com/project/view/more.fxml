<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.controller.MoreController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #ECF0F1;">

    <!-- Título -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
            <Label text="Mais"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Conteúdo principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20 40 20 40;"
              prefWidth="600">

            <!-- ==================== PERFIL DO PACIENTE ==================== -->

            <Label text="Seu Perfil"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="10">
                <Label text="Nome:"/>
                <Label fx:id="nameLabel"/>

                <Label text="Email:" GridPane.rowIndex="1"/>
                <Label fx:id="emailLabel" GridPane.rowIndex="1"/>

                <Label text="Data de Nascimento:" GridPane.rowIndex="2"/>
                <Label fx:id="birthLabel" GridPane.rowIndex="2"/>

                <Label text="Tipo de Diabetes:" GridPane.rowIndex="3"/>
                <Label fx:id="diabetesTypeLabel" GridPane.rowIndex="3"/>

                <Label text="Sensibilidade (mg/dL por g):" GridPane.rowIndex="4"/>
                <Label fx:id="sensitivityLabel" GridPane.rowIndex="4"/>
            </GridPane>

            <Separator/>

            <!-- ==================== AÇÕES ==================== -->
            <Label text="Ações"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Button text="Ajustar Sensibilidade"
                    onAction="#onAdjustSensitivity"
                    style="-fx-background-color: #3498DB; -fx-text-fill: white;"
                    prefWidth="200"/>

            <Button text="Logout"
                    onAction="#onLogout"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white;"
                    prefWidth="200"/>

            <Separator/>

            <!-- ==================== SOBRE ==================== -->
            <Label text="Sobre o Aplicativo"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label wrapText="true"
                   text="Aplicativo acadêmico desenvolvido para auxiliar no registro e acompanhamento da glicemia de pacientes diabéticos. Versão 1.0."/>
        </VBox>
    </center>

</BorderPane>