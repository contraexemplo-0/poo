<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.controller.RegisterController"
            prefWidth="480" prefHeight="720"
            styleClass="app-background">

    <center>
        <VBox alignment="TOP_CENTER" spacing="24" prefWidth="360">

            <!-- CARD -->
            <VBox alignment="CENTER" spacing="16" styleClass="auth-card">

                <!-- LOGO -->
                <ImageView fx:id="logoImage"
                           fitHeight="95"
                           preserveRatio="true"/>

                <!-- TÍTULO -->
                <Label text="Criar Conta"
                       styleClass="auth-title"/>

                <!-- CAMPOS -->
                <VBox spacing="12" alignment="CENTER" prefWidth="300">

                    <TextField fx:id="nameField"
                               promptText="Nome completo"
                               styleClass="auth-input"/>

                    <TextField fx:id="emailField"
                               promptText="Email"
                               styleClass="auth-input"/>

                    <HBox spacing="10" alignment="CENTER">
                        <DatePicker fx:id="birthDatePicker"
                                    promptText="Data de nascimento"
                                    prefWidth="145"
                                    styleClass="auth-input"/>

                        <ComboBox fx:id="genderCombo"
                                  promptText="Gênero"
                                  prefWidth="145"
                                  styleClass="auth-input"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <ComboBox fx:id="diabetesTypeCombo"
                                  promptText="Tipo de diabetes"
                                  prefWidth="145"
                                  styleClass="auth-input"/>

                        <DatePicker fx:id="diagnosisDatePicker"
                                    promptText="Data diagnóstico"
                                    prefWidth="145"
                                    styleClass="auth-input"/>
                    </HBox>

                    <PasswordField fx:id="passwordField"
                                   promptText="Senha"
                                   styleClass="auth-input"/>
                </VBox>

                <!-- BOTÃO -->
                <Button text="Cadastrar"
                        prefWidth="220"
                        onAction="#onRegister"
                        styleClass="auth-button"/>

                <!-- LINK -->
                <Hyperlink text="Já tem conta? Entrar"
                           onAction="#onGoToLogin"
                           styleClass="auth-link"/>

                <!-- ERRO -->
                <Label fx:id="errorLabel"
                       textFill="red"
                       visible="false"
                       styleClass="auth-error"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
