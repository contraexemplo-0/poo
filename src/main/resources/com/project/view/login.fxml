<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.controller.LoginController"
            prefWidth="400" prefHeight="500">

    <center>
        <VBox spacing="18" alignment="CENTER">
            <Label text="Entrar no Sistema" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <TextField fx:id="emailField" promptText="Email" prefWidth="250"/>
            <PasswordField fx:id="passwordField" promptText="Senha" prefWidth="250"/>

            <Button text="Entrar"
                    prefWidth="200"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                    onAction="#onLogin"/>

            <Hyperlink text="Criar uma conta" onAction="#onGoToRegister"/>

            <Label fx:id="errorLabel"
                   textFill="red"
                   style="-fx-font-size: 12px;"
                   visible="false"/>
        </VBox>
    </center>

</BorderPane>
