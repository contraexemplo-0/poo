<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.project.controller.LoginController"
           stylesheets="@css/login.css">

    <VBox alignment="CENTER" spacing="20">

        <!-- Área superior vazia para centralizar -->
        <Pane minHeight="40"/>

        <!-- CARTÃO -->
        <VBox id="card" spacing="18" alignment="CENTER">

            <!-- LOGO -->
            <ImageView fx:id="logoImage"
                       id="logo"
                       fitHeight="160"
                       preserveRatio="true"/>

            <Label id="title" text="Login"/>
            <Label id="subtitle" text="Gerenciamento inteligente de diabetes"/>

            <!-- FORM -->
            <VBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20;">
                <Label text="Email"/>
                <TextField fx:id="emailField" promptText="seu@email.com"/>
                <Label text="Senha"/>
                <PasswordField fx:id="passwordField" promptText="********"/>
            </VBox>

            <Button id="loginButton" text="Entrar"
                    onAction="#onLogin"
                    prefWidth="220"/>

            <Label fx:id="errorLabel"
                   textFill="red"
                   visible="false"
                   style="-fx-font-size: 12px;"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Não tem conta?"/>
                <Label text="Cadastre-se" styleClass="link-label"
                       onMouseClicked="#onGoToRegister"/>
            </HBox>

        </VBox>

        <Pane minHeight="40"/>

    </VBox>

</StackPane>