<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.controller.DashboardController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #ECF0F1;">

    <!-- ================= TOPO: TÍTULO + BOTÃO ================= -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT"
              style="-fx-padding: 20;">
            <Label text="Sua Evolução"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="+ Novo Registro"
                    onAction="#onNewEvent"
                    style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 14px;"
                    prefWidth="150"/>
        </HBox>
    </top>

    <!-- ================= CENTRO: GRÁFICO + CARDS ================= -->
    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">

            <!-- ====== Gráfico ====== -->
            <LineChart fx:id="glucoseChart" prefHeight="250">
                <xAxis>
                    <CategoryAxis label="Data/Hora"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Glicose (mg/dL)"/>
                </yAxis>
            </LineChart>

            <!-- ====== Cards de resumo ====== -->
            <HBox spacing="20" alignment="CENTER_LEFT">

                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="HbA1c Estimada" style="-fx-font-weight: bold;"/>
                    <Label fx:id="hba1cLabel" style="-fx-font-size: 18px;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="Média Glicêmica" style="-fx-font-weight: bold;"/>
                    <Label fx:id="meanLabel" style="-fx-font-size: 18px;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="Hiper" style="-fx-font-weight: bold;"/>
                    <Label fx:id="hyperLabel" style="-fx-font-size: 18px; -fx-text-fill: #E74C3C;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="Hipo" style="-fx-font-weight: bold;"/>
                    <Label fx:id="hypoLabel" style="-fx-font-size: 18px; -fx-text-fill: #3498DB;"/>
                </VBox>

            </HBox>

            <!-- ====== Lista de eventos ====== -->
            <VBox spacing="10">
                <Label text="Registros Recentes"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ListView fx:id="eventsList" prefHeight="200"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
